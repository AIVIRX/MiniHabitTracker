        },
        "en-IN" : {
          "stringUnit" : {
            "value" : "This will permanently delete all your habits, completions, and achievements. This action cannot be undone.",
            "state" : "translated"
          }
        },
        "ro" : {
          "stringUnit" : {
            "value" : "Aceasta va șterge permanent toate obiceiurile, completările și realizările tale. Această acțiune nu poate fi anulată.",
            "state" : "translated"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्थायी रूप से आपकी सभी आदतों, पूर्णताओं और उपलब्धियों को हटा देगा। यह क्रिया पूर्ववत नहीं की जा सकती।"
