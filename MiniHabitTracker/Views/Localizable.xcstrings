        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, tüm alışkanlıklarınızı, tamamlamalarınızı ve başarılarınızı kalıcı olarak silecektir. Bu işlem geri alınamaz."
