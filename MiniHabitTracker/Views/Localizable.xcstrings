          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Tem certeza de que deseja excluir '%@'? Esta ação não pode ser desfeita.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir supprimer '%@' ? Cette action ne peut pas être annulée."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا آپ واقعی '%@' کو حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں لیا جا سکتا۔"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Apakah Anda yakin ingin menghapus '%@'? Tindakan ini tidak dapat dibatalkan.",
