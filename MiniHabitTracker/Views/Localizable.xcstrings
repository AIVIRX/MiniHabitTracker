        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除您所有的習慣、完成和成就。此操作無法撤消。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà permanentemente tutte le tue abitudini, completamenti e risultati. Questa azione non può essere annullata."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще изтрие постоянно всички ваши навици, завършвания и постижения. Това действие не може да бъде отменено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto trvalo natrvalo odstrániť všetky vaše návyky, dokončenia a úspechy. Túto akciu nie je možné vrátiť späť."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ તમારા તમામ આદતો, પૂર્ણતાઓ અને સિદ્ધિઓને કાયમી રીતે કાઢી નાખશે. આ ક્રિયા પાછી નથી ખેંચી શકાય."
          }
        },
        "sv" : {
          "stringUnit" : {
