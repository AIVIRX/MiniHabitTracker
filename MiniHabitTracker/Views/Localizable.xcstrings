    "This will permanently delete all your habits, completions, and achievements. This action cannot be undone." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bo trajno izbrisalo vse vaše navade, dokončanja in dosežke. Te akcije ni mogoče razveljaviti."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Esto eliminará permanentemente todos tus hábitos, finalizaciones y logros. Esta acción no se puede deshacer.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Cela supprimera définitivement toutes vos habitudes, réalisations et succès. Cette action ne peut pas être annulée.",
            "state" : "translated"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ آپ کی تمام عادات، تکمیلیں، اور کامیابیاں مستقل طور پر حذف کر دے گا۔ یہ عمل واپس نہیں لیا جا سکتا۔"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua kebiasaan, penyelesaian, dan pencapaian Anda secara permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Dit zal al je gewoonten, voltooiingen en prestaties permanent verwijderen. Deze actie kan niet ongedaan worden gemaakt.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wird alle Ihre Gewohnheiten, Abschlüsse und Errungenschaften dauerhaft löschen. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "سيؤدي هذا إلى حذف جميع عاداتك، وإنجازاتك، وإنجازاتك بشكل دائم. لا يمكن التراجع عن هذا الإجراء.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਇਹ ਤੁਹਾਡੇ ਸਾਰੇ ਆਦਤਾਂ, ਪੂਰਨਤਾਵਾਂ ਅਤੇ ਉਪਲਬਧੀਆਂ ਨੂੰ ਸਥਾਈ ਤੌਰ 'ਤੇ ਮਿਟਾ ਦੇਵੇਗਾ। ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除您所有的习惯、完成和成就。此操作无法撤销。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memadamkan semua kebiasaan, penyelesaian, dan pencapaian anda secara kekal. Tindakan ini tidak boleh dibatalkan."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all your habits, completions, and achievements. This action cannot be undone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "value" : "Tämä poistaa pysyvästi kaikki tapasi, suorituksesi ja saavutuksesi. Tätä toimintoa ei voi peruuttaa.",
            "state" : "translated"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos tus hábitos, finalizaciones y logros. Esta acción no se puede deshacer."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos tus hábitos, finalizaciones y logros. Esta acción no se puede deshacer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це назавжди видалить всі ваші звички, завершення та досягнення. Цю дію не можна скасувати."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს მუდმივად წაშლის ყველა თქვენს ჩვევას, დასრულებას და წარმატებას. ეს მოქმედება ვერ იქნება გაუქმებული."
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "To na zawsze usunie wszystkie twoje nawyki, zakończenia i osiągnięcia. Ta akcja nie może być cofnięta.",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all your habits, completions, and achievements. This action cannot be undone."
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Dette vil permanent slette alle dine vaner, fuldførelser og præstationer. Denne handling kan ikke fortrydes.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Điều này sẽ xóa vĩnh viễn tất cả thói quen, lần hoàn thành và thành tích của bạn. Hành động này không thể hoàn tác.",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি আপনার সমস্ত অভ্যাস, সম্পূর্ণতা এবং অর্জন স্থায়ীভাবে মুছে ফেলবে। এই পদক্ষেপটি পূর্বাবস্থায় ফিরিয়ে নেওয়া যাবে না।"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Esto eliminará permanentemente todos tus hábitos, finalizaciones y logros. Esta acción no se puede deshacer.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ನಿಮ್ಮ ಎಲ್ಲಾ ಆದತಗಳು, ಪೂರ್ಣತೆಗಳು ಮತ್ತು ಅಭಿವೃದ್ಧಿಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸುತ್ತದೆ. ಈ ಕ್ರಿಯೆಯನ್ನು ಹಿಂದಿರುಗಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "זה ימחק לצמיתות את כל ההרגלים, ההשלמות וההישגים שלך. פעולה זו אינה ניתנת לביטול.",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे तुमच्या सर्व आदती, पूर्णता, आणि उपलब्ध्या कायमचे हटवेल. हा क्रिया पूर्ववत केला जाऊ शकत नाही."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente todos os seus hábitos, conclusões e conquistas. Esta ação não pode ser desfeita."
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "การกระทำนี้จะลบพฤติกรรม การทำเสร็จ และความสำเร็จทั้งหมดของคุณอย่างถาวร ไม่สามารถย้อนกลับได้.",
            "state" : "translated"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això eliminarà permanentment tots els teus hàbits, completions i logros. Aquesta acció no es pot desfer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "value" : "Это действие навсегда удалит все ваши привычки, завершения и достижения. Это действие нельзя отменить.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл барлық әдеттеріңізді, аяқталуларыңызды және жетістіктеріңізді тұрақты түрде жояды. Бұл әрекет қайтарылмайды."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement toutes vos habitudes, réalisations et succès. Cette action ne peut pas être annulée."
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Tai visam laikui ištrins visus jūsų įpročius, užbaigimus ir pasiekimus. Šis veiksmas negali būti atšauktas.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto trvale smaže všechny vaše návyky, dokončení a úspěchy. Tato akce nelze vrátit zpět."
